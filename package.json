{
  "name": "shellnexa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "check": "biome check .",
    "check:unsafe": "biome check --write --unsafe .",
    "check:write": "biome check --write .",
    "dev": "next dev --turbo",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "dev:setup": "bash scripts/dev-start.sh",
    "dev:backend": "cd services/api-gateway && pnpm run start:dev",
    "dev:services": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:stop": "docker-compose -f docker-compose.dev.yml down",
    "dev:clean": "docker-compose -f docker-compose.dev.yml down -v",
    "build:types": "cd shared/types && pnpm run build",
    "build:services": "pnpm run -r build --filter='@shellnexa/*'",
    "test:services": "pnpm run -r test --filter='@shellnexa/*'",
    "lint:services": "pnpm run -r lint --filter='@shellnexa/*'",
    "db:setup": "bash scripts/setup-databases.sh",
    "db:check": "bash scripts/setup-databases.sh --check-only",
    "db:reset": "bash scripts/setup-databases.sh --drop-existing",
    "env:setup": "bash scripts/create-env-files.sh",
    "setup:full": "pnpm run env:setup && pnpm run db:setup && pnpm install",
    "migrate:all": "pnpm run -r migrate --filter='@shellnexa/*'",
    "seed:all": "pnpm run -r seed --filter='@shellnexa/*'",
    "docker:db:start": "bash scripts/docker-db-setup.sh start",
    "docker:db:stop": "bash scripts/docker-db-setup.sh stop",
    "docker:db:restart": "bash scripts/docker-db-setup.sh restart",
    "docker:db:setup": "bash scripts/docker-db-setup.sh setup",
    "docker:db:status": "bash scripts/docker-db-setup.sh status",
    "docker:db:logs": "bash scripts/docker-db-setup.sh logs",
    "docker:db:cleanup": "bash scripts/docker-db-setup.sh cleanup",
    "docker:db:info": "bash scripts/docker-db-setup.sh info"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@t3-oss/env-nextjs": "^0.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.2"
  },
  "ct3aMetadata": {
    "initVersion": "7.39.3"
  },
  "packageManager": "pnpm@10.18.1"
}
