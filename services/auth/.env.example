# Auth Service Configuration
PORT=3002
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shellnexa_app
DB_PASSWORD=shellnexa_app_dev
DB_DATABASE=auth_service

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (for verification emails)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@shellnexa.com

# Security
BCRYPT_ROUNDS=12
SESSION_CLEANUP_INTERVAL=3600000

# Logging
LOG_LEVEL=info
