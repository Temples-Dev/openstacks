# Reporting Service Configuration
PORT=3007
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=shellnexa_reporting
DB_SSL=false

# Service URLs for data collection
AUTH_SERVICE_URL=http://localhost:3002
CATALOG_SERVICE_URL=http://localhost:3003
CIRCULATION_SERVICE_URL=http://localhost:3004
ACQUISITIONS_SERVICE_URL=http://localhost:3005
DISCOVERY_SERVICE_URL=http://localhost:3006

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.shellnexa.com

# Analytics Configuration
ENABLE_REAL_TIME_ANALYTICS=true
ENABLE_HISTORICAL_ANALYSIS=true
ENABLE_TREND_ANALYSIS=true
ENABLE_PREDICTIVE_ANALYTICS=false
DATA_RETENTION_DAYS=2555
METRIC_COLLECTION_INTERVAL=3600

# Dashboard Configuration
ENABLE_DASHBOARDS=true
DEFAULT_REFRESH_INTERVAL=300
MAX_DASHBOARD_WIDGETS=50
ENABLE_CUSTOM_DASHBOARDS=true
ENABLE_DASHBOARD_SHARING=true

# Report Configuration
ENABLE_SCHEDULED_REPORTS=true
ENABLE_REPORT_EXPORT=true
REPORT_RETENTION_DAYS=365
MAX_REPORT_SIZE_MB=100
SUPPORTED_FORMATS=pdf,excel,csv,json,html

# Alert Configuration
ENABLE_ALERTS=true
ALERT_CHECK_INTERVAL=300
ENABLE_EMAIL_ALERTS=true
ENABLE_WEBHOOK_ALERTS=false
SYSTEM_UPTIME_THRESHOLD=95
BUDGET_UTILIZATION_THRESHOLD=90
OVERDUE_ITEMS_THRESHOLD=100

# Performance Configuration
HTTP_TIMEOUT=15000
DB_CONNECTION_POOL_SIZE=20
CACHE_TTL=1800
ENABLE_QUERY_CACHING=true
ENABLE_RESULT_COMPRESSION=true

# Data Collection Configuration
COLLECT_HOURLY_METRICS=true
COLLECT_DAILY_SUMMARIES=true
COLLECT_WEEKLY_SUMMARIES=true
COLLECT_MONTHLY_SUMMARIES=true
ENABLE_AUTOMATED_CLEANUP=true

# Chart and Visualization Configuration
DEFAULT_CHART_LIBRARY=chartjs
ENABLE_INTERACTIVE_CHARTS=true
CHART_EXPORT_FORMATS=png,svg,pdf
MAX_CHART_DATA_POINTS=1000

# Security Configuration
ENABLE_AUDIT_LOGGING=true
AUDIT_RETENTION_DAYS=2555
REQUIRE_AUTHORIZATION=true
ENABLE_ROLE_BASED_ACCESS=true
ENABLE_DATA_ANONYMIZATION=false

# Export Configuration
ENABLE_DATA_EXPORT=true
EXPORT_RATE_LIMIT=10
MAX_EXPORT_RECORDS=100000
EXPORT_FORMATS=csv,json,excel

# Integration Configuration
ENABLE_EXTERNAL_APIS=false
ENABLE_WEBHOOK_NOTIFICATIONS=false
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_ATTEMPTS=3

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=reports@shellnexa.com

# File Storage Configuration
REPORT_STORAGE_PATH=/reports
DASHBOARD_EXPORT_PATH=/dashboard-exports
TEMP_FILE_PATH=/tmp/reporting
MAX_FILE_AGE_DAYS=30

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_LOGGING=true
LOG_RETENTION_DAYS=90

# Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups/reporting

# Feature Flags
ENABLE_ADVANCED_ANALYTICS=true
ENABLE_MACHINE_LEARNING=false
ENABLE_ANOMALY_DETECTION=true
ENABLE_FORECASTING=false
ENABLE_CUSTOM_METRICS=true
ENABLE_API_ANALYTICS=true
ENABLE_USER_BEHAVIOR_TRACKING=true

# Third-party Integrations
ENABLE_GOOGLE_ANALYTICS=false
GOOGLE_ANALYTICS_ID=
ENABLE_TABLEAU_INTEGRATION=false
TABLEAU_SERVER_URL=
ENABLE_POWER_BI_INTEGRATION=false
POWER_BI_WORKSPACE_ID=

# Performance Monitoring
ENABLE_PERFORMANCE_MONITORING=true
PERFORMANCE_SAMPLE_RATE=0.1
ENABLE_MEMORY_MONITORING=true
ENABLE_CPU_MONITORING=true
ENABLE_DISK_MONITORING=true

# Compliance and Privacy
ENABLE_GDPR_COMPLIANCE=true
ENABLE_DATA_MASKING=false
ENABLE_CONSENT_TRACKING=false
DATA_RETENTION_POLICY=standard

# Clustering and Scaling
ENABLE_CLUSTERING=false
CLUSTER_NODE_ID=node1
ENABLE_LOAD_BALANCING=false
ENABLE_AUTO_SCALING=false
