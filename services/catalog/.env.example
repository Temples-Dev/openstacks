# Catalog Service Configuration
PORT=3003
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=shellnexa_app
DB_PASSWORD=shellnexa_app_dev
DB_DATABASE=catalog_service

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.mrc,.xml,.json,.txt

# MARC Processing Configuration
DEFAULT_MARC_FORMAT=MARC21
DEFAULT_CHARACTER_ENCODING=UTF-8
MARC_VALIDATION_ENABLED=true

# Search Configuration
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100
SEARCH_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
DB_CONNECTION_POOL_SIZE=10
QUERY_TIMEOUT=30000

# Feature Flags
ENABLE_MARC_IMPORT=true
ENABLE_MARC_EXPORT=true
ENABLE_AUTHORITY_CONTROL=true
ENABLE_SEARCH_SUGGESTIONS=true
