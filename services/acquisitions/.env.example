# Acquisitions Service Configuration
PORT=3005
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=shellnexa_acquisitions
DB_SSL=false

# Service URLs
CATALOG_SERVICE_URL=http://localhost:3003
AUTH_SERVICE_URL=http://localhost:3002

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.shellnexa.com

# Financial Configuration
DEFAULT_CURRENCY=USD
DEFAULT_TAX_RATE=0.08
ENABLE_MULTI_CURRENCY=true
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD

# Purchase Order Configuration
PO_NUMBER_PREFIX=PO
RECEIPT_NUMBER_PREFIX=REC
INVOICE_NUMBER_PREFIX=INV
AUTO_APPROVE_THRESHOLD=1000.00
REQUIRE_THREE_WAY_MATCHING=true

# Vendor Management
VENDOR_PERFORMANCE_TRACKING=true
AUTO_VENDOR_RATING=true
VENDOR_CLAIM_THRESHOLD_DAYS=7
MAX_CLAIM_ATTEMPTS=3

# Budget Management
BUDGET_WARNING_THRESHOLD=80
BUDGET_STOP_THRESHOLD=95
ENABLE_BUDGET_ALERTS=true
BUDGET_ROLLOVER_ENABLED=true

# Workflow Configuration
ENABLE_APPROVAL_WORKFLOW=true
REQUIRE_MANAGER_APPROVAL=true
RUSH_ORDER_APPROVAL_REQUIRED=true
AUTO_RECEIVE_THRESHOLD=500.00

# Notification Configuration
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_OVERDUE_ALERTS=true
NOTIFICATION_FREQUENCY=daily
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=

# Reporting Configuration
ENABLE_FINANCIAL_REPORTS=true
ENABLE_VENDOR_REPORTS=true
ENABLE_BUDGET_REPORTS=true
REPORT_RETENTION_DAYS=365

# Integration Configuration
ENABLE_CATALOG_INTEGRATION=true
ENABLE_CIRCULATION_INTEGRATION=true
AUTO_ADD_TO_CATALOG=true
CATALOG_ON_RECEIPT=true

# Performance Configuration
HTTP_TIMEOUT=10000
DB_CONNECTION_POOL_SIZE=10
CACHE_TTL=3600
ENABLE_QUERY_LOGGING=false

# Security Configuration
ENABLE_AUDIT_LOGGING=true
AUDIT_RETENTION_DAYS=2555
REQUIRE_AUTHORIZATION=true
ENABLE_FIELD_ENCRYPTION=false

# Automation Configuration
ENABLE_SCHEDULED_TASKS=true
OVERDUE_CHECK_FREQUENCY=daily
CLAIM_GENERATION_FREQUENCY=daily
VENDOR_PERFORMANCE_UPDATE_FREQUENCY=weekly
BUDGET_ALERT_FREQUENCY=daily

# File Upload Configuration
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=pdf,jpg,jpeg,png,doc,docx,xls,xlsx
UPLOAD_PATH=/uploads/acquisitions

# Backup Configuration
ENABLE_AUTO_BACKUP=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/backups/acquisitions

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
LOG_RETENTION_DAYS=90

# Feature Flags
ENABLE_RUSH_ORDERS=true
ENABLE_STANDING_ORDERS=true
ENABLE_BLANKET_ORDERS=true
ENABLE_APPROVAL_PLANS=true
ENABLE_EDI_INTEGRATION=false
ENABLE_VENDOR_CATALOGS=true
ENABLE_PRICE_COMPARISON=true
