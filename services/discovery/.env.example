# Discovery Service Configuration
PORT=3006
NODE_ENV=development

# Service URLs
CATALOG_SERVICE_URL=http://localhost:3003
CIRCULATION_SERVICE_URL=http://localhost:3004
AUTH_SERVICE_URL=http://localhost:3002

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://*.shellnexa.com

# Search Configuration
DEFAULT_SEARCH_LIMIT=20
MAX_SEARCH_LIMIT=100
SEARCH_TIMEOUT=10000
ENABLE_FUZZY_SEARCH=true
FUZZY_SEARCH_THRESHOLD=0.4

# Recommendations Configuration
RECOMMENDATION_CACHE_TTL=3600
MAX_PERSONALIZED_RECOMMENDATIONS=20
ENABLE_COLLABORATIVE_FILTERING=true
ENABLE_CONTENT_BASED_FILTERING=true

# Collections Configuration
FEATURED_COLLECTIONS_COUNT=6
SEASONAL_COLLECTIONS_ENABLED=true
EXHIBIT_COLLECTIONS_ENABLED=true
SUBJECT_GUIDES_ENABLED=true

# Patron Self-Service Configuration
ENABLE_PATRON_LOGIN=true
ENABLE_LOAN_RENEWALS=true
ENABLE_HOLD_MANAGEMENT=true
ENABLE_NOTIFICATION_PREFERENCES=true
MAX_RENEWAL_ATTEMPTS=3

# Caching Configuration
CACHE_TTL_SEARCH_RESULTS=300
CACHE_TTL_RECOMMENDATIONS=1800
CACHE_TTL_COLLECTIONS=3600
CACHE_TTL_POPULAR_ITEMS=7200

# Image Configuration
COVER_IMAGE_SERVICE=openlibrary
DEFAULT_COVER_IMAGE=/assets/images/default-book-cover.png
ENABLE_IMAGE_PROXY=true
IMAGE_CACHE_TTL=86400

# Analytics Configuration
ENABLE_SEARCH_ANALYTICS=true
ENABLE_USAGE_TRACKING=true
ANALYTICS_RETENTION_DAYS=90

# Performance Configuration
HTTP_TIMEOUT=10000
MAX_CONCURRENT_REQUESTS=50
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_ADVANCED_SEARCH=true
ENABLE_SEARCH_SUGGESTIONS=true
ENABLE_TRENDING_TOPICS=true
ENABLE_STAFF_PICKS=true
ENABLE_AWARD_WINNERS=true
ENABLE_NEW_ACQUISITIONS=true

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true

# Security
ENABLE_CORS=true
ENABLE_HELMET=true
ENABLE_COMPRESSION=true
TRUST_PROXY=false
