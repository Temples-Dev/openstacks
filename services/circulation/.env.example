# Circulation Service Configuration
PORT=3004
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=openstacks
DB_PASSWORD=openstacks_dev
DB_DATABASE=circulation_service

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Circulation Policies
DEFAULT_LOAN_PERIOD_DAYS=21
DEFAULT_RENEWAL_LIMIT=2
DEFAULT_HOLD_LIMIT=5
DEFAULT_CHECKOUT_LIMIT=10
DEFAULT_FINE_LIMIT=50.00

# Fine Configuration
OVERDUE_FINE_DAILY_RATE=0.25
RESERVE_FINE_DAILY_RATE=1.00
MAX_OVERDUE_FINE=25.00
PROCESSING_FEE=5.00
REPLACEMENT_FEE_MULTIPLIER=1.5

# Hold Configuration
HOLD_EXPIRATION_DAYS=365
PICKUP_DEADLINE_DAYS=7
HOLD_NOTIFICATION_METHODS=email,sms,phone

# Auto-renewal Configuration
AUTO_RENEWAL_ENABLED=true
AUTO_RENEWAL_DAYS_BEFORE_DUE=3
MAX_AUTO_RENEWALS=1

# Notification Configuration
OVERDUE_NOTICE_INTERVAL_DAYS=7
COURTESY_NOTICE_DAYS_BEFORE_DUE=3
FINAL_NOTICE_DAYS_OVERDUE=14

# Collection Configuration
LOST_ITEM_DAYS_OVERDUE=60
COLLECTION_THRESHOLD_AMOUNT=25.00
COLLECTION_THRESHOLD_DAYS=90

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Performance
DB_CONNECTION_POOL_SIZE=10
QUERY_TIMEOUT=30000

# Feature Flags
ENABLE_AUTO_RENEWALS=true
ENABLE_HOLD_NOTIFICATIONS=true
ENABLE_FINE_CALCULATIONS=true
ENABLE_OVERDUE_PROCESSING=true
