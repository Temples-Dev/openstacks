{
  "databases": {
    "api-gateway": {
      "name": "openstacks_gateway",
      "description": "API Gateway & Routing",
      "port": 3001,
      "user": "openstacks_gateway_user",
      "schemas": ["public", "audit", "config", "routing"],
      "extensions": ["uuid-ossp", "pg_trgm"]
    },
    "auth": {
      "name": "openstacks_auth",
      "description": "Authentication & Authorization",
      "port": 3002,
      "user": "openstacks_auth_user",
      "schemas": ["public", "audit", "config", "sessions"],
      "extensions": ["uuid-ossp", "pg_trgm", "pgcrypto"]
    },
    "catalog": {
      "name": "openstacks_catalog",
      "description": "Library Catalog Management",
      "port": 3003,
      "user": "openstacks_catalog_user",
      "schemas": ["public", "audit", "config", "marc", "metadata"],
      "extensions": ["uuid-ossp", "pg_trgm", "unaccent", "btree_gin"]
    },
    "circulation": {
      "name": "openstacks_circulation",
      "description": "Circulation & Lending",
      "port": 3004,
      "user": "openstacks_circulation_user",
      "schemas": ["public", "audit", "config", "transactions"],
      "extensions": ["uuid-ossp", "pg_trgm", "btree_gin"]
    },
    "acquisitions": {
      "name": "openstacks_acquisitions",
      "description": "Acquisitions & Ordering",
      "port": 3005,
      "user": "openstacks_acquisitions_user",
      "schemas": ["public", "audit", "config", "orders", "vendors"],
      "extensions": ["uuid-ossp", "pg_trgm"]
    },
    "discovery": {
      "name": "openstacks_discovery",
      "description": "Search & Discovery",
      "port": 3006,
      "user": "openstacks_discovery_user",
      "schemas": ["public", "audit", "config", "search", "facets"],
      "extensions": ["uuid-ossp", "pg_trgm", "unaccent", "btree_gin", "btree_gist"]
    },
    "reporting": {
      "name": "openstacks_reporting",
      "description": "Analytics & Reporting",
      "port": 3007,
      "user": "openstacks_reporting_user",
      "schemas": ["public", "audit", "config", "analytics", "reports"],
      "extensions": ["uuid-ossp", "pg_trgm", "btree_gin"]
    },
    "multi-tenant": {
      "name": "openstacks_multitenant",
      "description": "Multi-Tenant Architecture",
      "port": 3008,
      "user": "openstacks_multitenant_user",
      "schemas": ["public", "audit", "config", "tenants", "libraries", "geospatial"],
      "extensions": ["uuid-ossp", "pg_trgm", "postgis", "btree_gin"]
    },
    "ill": {
      "name": "openstacks_ill",
      "description": "Interlibrary Loan System",
      "port": 3009,
      "user": "openstacks_ill_user",
      "schemas": ["public", "audit", "config", "requests", "partners", "protocols"],
      "extensions": ["uuid-ossp", "pg_trgm", "btree_gin"]
    },
    "e-resources": {
      "name": "openstacks_eresources",
      "description": "E-Resource Management",
      "port": 3010,
      "user": "openstacks_eresources_user",
      "schemas": ["public", "audit", "config", "licenses", "usage", "access"],
      "extensions": ["uuid-ossp", "pg_trgm", "btree_gin"]
    },
    "digital-repository": {
      "name": "openstacks_repository",
      "description": "Digital Repository & Preservation",
      "port": 3011,
      "user": "openstacks_repository_user",
      "schemas": ["public", "audit", "config", "preservation", "metadata", "collections", "objects"],
      "extensions": ["uuid-ossp", "pg_trgm", "btree_gin", "btree_gist"]
    },
    "ai-ml": {
      "name": "openstacks_aiml",
      "description": "AI/ML Engine & Recommendations",
      "port": 3012,
      "user": "openstacks_aiml_user",
      "schemas": ["public", "audit", "config", "models", "predictions", "training", "analytics"],
      "extensions": ["uuid-ossp", "pg_trgm", "btree_gin"]
    }
  },
  "defaultConfig": {
    "host": "localhost",
    "port": 5432,
    "adminUser": "postgres",
    "adminPassword": "password",
    "adminDatabase": "postgres",
    "charset": "UTF8",
    "collation": "en_US.UTF-8"
  },
  "environments": {
    "development": {
      "host": "localhost",
      "port": 5432,
      "ssl": false
    },
    "staging": {
      "host": "staging-db.openstacks.com",
      "port": 5432,
      "ssl": true
    },
    "production": {
      "host": "prod-db.openstacks.com",
      "port": 5432,
      "ssl": true,
      "poolSize": 20,
      "connectionTimeout": 30000
    }
  }
}
